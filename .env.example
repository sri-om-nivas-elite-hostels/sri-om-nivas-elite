# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.
# All values except NEXT_PUBLIC_SITE_URL are server-only secrets/config — never prefix them with NEXT_PUBLIC_.

# Resend API key (https://resend.com/api-keys). Leave empty to keep online enquiries disabled.
RESEND_API_KEY=

# Inbox that receives website enquiries (e.g. the property's confirmed contact inbox).
CONTACT_TO_EMAIL=

# Sender on a domain you have VERIFIED in Resend, e.g. "Sri Om Nivas Website <enquiries@your-verified-domain>".
# A Gmail address cannot be used as the sender.
CONTACT_FROM_EMAIL=

# Public base URL of the site, no trailing slash (e.g. https://www.example.com). Used for canonical URLs,
# sitemap, robots and Open Graph. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=
